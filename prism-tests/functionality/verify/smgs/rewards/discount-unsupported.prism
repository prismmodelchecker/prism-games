// Small SMG used to check that {discount=...} options on temporal
// operators in R operators are rejected for games (rather than ignored)
smg
player p1 [a1], [b1] endplayer
player p2 [a2] endplayer
module m
 s : [0..3] init 0;
 [a1] s=0 -> 0.5:(s'=1) + 0.5:(s'=2);
 [b1] s=0 -> (s'=2);
 [a2] s=1 -> 0.5:(s'=0) + 0.5:(s'=3);
 [] s>=2 -> true;
endmodule
rewards "r" [a1] true : 1; [b1] true : 2; [a2] true : 3; endrewards
